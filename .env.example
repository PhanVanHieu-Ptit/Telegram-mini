MONGO_URI=mongodb://admin@localhost:27017/
MONGO_DB_NAME=chat_app
# Google OAuth2
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebooke OAuth2
FACEBOOK_CLIENT_ID=your_client_id
FACEBOOK_CLIENT_SECRET=your_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# JWT Setup
JWT_SECRET=your_jwt_secret_at_least_32_chars
FRONTEND_URL=http://localhost:5173
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chat_app
PG_USER=admin
PG_PASSWORD=
PORT=3000
HOST=0.0.0.0
MQTT_BROKER_URL=mqtt://localhost:1883
PUBLIC_MQTT_URL=mqtt://localhost:1883
PUBLIC_MQTT_USER=
PUBLIC_MQTT_PASS=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars
# WebRTC signaling service integration
RTC_SERVICE_URL=http://localhost:4000
INTERNAL_API_KEY=change-me-to-a-long-random-secret
# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"


METERED_APP_HOST=''
METERED_API_KEY=''
NODE_ENV='development'
# Set PG_SSL='true' on Render/production if database requires SSL.
PG_SSL='false'
# Keep 'false' for providers with self-signed certs; set 'true' for strict CA validation.
PG_SSL_REJECT_UNAUTHORIZED='false'
